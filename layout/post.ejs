<article class="post <%= theme.terminal_color %>">
  <h2 class="post-title"><%= page.title || 'Untitled' %></h2>

  <p class="post-meta">
    <small>
    <% if (theme.dateFormat === 'EU') { %>
      <%= date(page.date, 'DD/MM/YYYY') %>
    <% } else { %>
      <%= date(page.date, 'YY/DD/YYYY') %>
    <% } %>
    </small>
    <% if (page.tags && page.tags.length) { %>
      <span class="post-tags">
        <% page.tags.each(function(tag){ %>
          <a href="<%- url_for(tag.path) %>" class="tag">#<%= tag.name %></a>
        <% }) %>
      </span>
    <% } %>
  </p>

  <div class="post-content">
    <%- page.content %>
  </div>
</article>
